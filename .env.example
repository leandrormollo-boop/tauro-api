# ============================================================
# Variables de entorno para Tauro API
# ============================================================
# En Render, copiar estas keys al panel "Environment" del servicio.
# El archivo credenciales.json se sube como "Secret File" en /etc/secrets/.

# ── App ─────────────────────────────────────────────────────
ENV=PROD
BASE_URL=https://taurosolutions.ar
SESSION_COOKIE_SECURE=1               # 1 = cookies solo por HTTPS
GOOGLE_CREDENTIALS_FILE=/etc/secrets/credenciales.json

# ── Google Sheets (sheet del API) ───────────────────────────
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/.../edit

# ── Email SMTP (Gmail App Password) ─────────────────────────
EMAIL_REMITENTE=operaciones@taurosolutions.ar
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_DESTINO=tu-email@gmail.com
EMAIL_FROM=TAURO Operaciones <operaciones@taurosolutions.ar>
EMAIL_REPLY_TO=operaciones@taurosolutions.ar
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_TIMEOUT=15
EMAIL_COTIZACIONES_MAX_HORA=100
EMAIL_ADMIN_RECOVERY_MAX_HORA=6
COTIZACION_WEB_VIGENCIA_HORAS=24

# ── FedEx ───────────────────────────────────────────────────
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT_NUMBER=
FEDEX_ENVIRONMENT=sandbox             # sandbox | production
# ⚠️ Antes de FEDEX_ENVIRONMENT=production revisar WEB_DESC_FEDEX_PCT o se
#    vende bajo costo (ver docs/RELEVO.md regla 8).

# ── DHL (MyDHL API) ─────────────────────────────────────────
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER_EXPO=              # cuenta para exportación
DHL_ACCOUNT_NUMBER_IMPO=             # cuenta para importación
DHL_ENVIRONMENT=sandbox              # sandbox | production

# ── UPS (Shipping API) ──────────────────────────────────────
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_ENVIRONMENT=sandbox              # sandbox | production

# ── Shopify (app pública) ───────────────────────────────────
# App pública TAURO: recibe todas las instalaciones nuevas.
SHOPIFY_PUBLIC_API_KEY=
SHOPIFY_PUBLIC_API_SECRET=
# App histórica: conservar durante la migración de Pesca Jacks. Si todavía no
# existen las variables PUBLIC, estas genéricas siguen siendo la app principal.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Alternativa explícita para retirar luego las variables genéricas.
SHOPIFY_LEGACY_API_KEY=
SHOPIFY_LEGACY_API_SECRET=
# Recomendado: material exclusivo para cifrar los tokens OAuth guardados.
# Si queda vacío se deriva de SHOPIFY_API_SECRET para no cortar instalaciones.
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# ── Tiendanube (app OAuth) ──────────────────────────────────
# Del Partners Portal de Tiendanube. Con las dos, la integración se
# auto-activa y aparece el botón "Instalar app de Tiendanube" en el portal.
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=

# ── Seguridad (opcionales) ──────────────────────────────────
ADMIN_TOTP_SECRET=                   # 2FA del admin (generar con scripts/generar_totp_admin.py)
CORS_ORIGINS=https://taurosolutions.ar,https://www.taurosolutions.ar
# EXTRA_HOSTS=

# ── Meta Ads (opt-in) ──────────────────────────────────────
# ID numérico del Pixel/Dataset. Vacío o ausente = Pixel completamente apagado.
# Sólo registra PageView en /web; sin advanced matching ni lectura automática de forms.
META_PIXEL_ID=

# ── Dólar oficial automático ────────────────────────────────
# COTIZACION_DOLAR_ARS se actualiza sola cada 6h desde el oficial. Estas son
# opcionales; los defaults ya sirven.
# DOLAR_AUTO=1                        # 0 = volver a manual (no se actualiza solo)
# DOLAR_AUTO_TIPO=venta              # venta | compra
# DOLAR_AUTO_FUENTE=https://dolarapi.com/v1/dolares/oficial
# DOLAR_SALTO_MAX_PCT=50             # no pisa solo un salto mayor a esto (%)

# ── Job semanal de actualización de precios ─────────────────
MARGEN_MINIMO_ALERTA_ARS=5000
CRON_DIA=mon
CRON_HORA=6
